<div class="kt-archetype-layout">
  <nav class="kt-archetype-list">
    {{#each archetypes as |archetype|}}
    <button type="button" class="kt-archetype-entry{{#if archetype.active}} active{{/if}}" data-action="select" data-id="{{archetype.id}}"
            aria-pressed="{{archetype.active}}">
      <span>{{archetype.label}}</span>
      {{#if archetype.custom}}<span class="kt-muted">{{localize "KT.Archetypes.Custom"}}</span>{{/if}}
    </button>
    {{/each}}
    <button type="button" data-action="create"><i class="fa-solid fa-plus" inert></i> {{localize "KT.Archetypes.New"}}</button>
  </nav>

  {{#if selected}}
  <section class="kt-archetype-form">
    <div class="form-group">
      <label for="{{rootId}}-label">{{localize "KT.Archetypes.Name"}} {{> kt-info text=(localize "KT.Archetypes.Id" id=selected.id)}}</label>
      <div class="form-fields">
        <input type="text" id="{{rootId}}-label" name="label" value="{{selected.label}}" placeholder="{{selected.placeholder}}">
      </div>
    </div>

    <div class="form-group">
      <label for="{{rootId}}-fence">{{localize "KT.Archetypes.Fence"}} {{> kt-info text=(localize "KT.Archetypes.FenceHint")}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{rootId}}-fence" name="fence" {{checked selected.fence}}>
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "KT.Archetypes.Skills"}}</label>
      <div class="form-fields">
        <multi-select name="skills">{{selectOptions skillOptions selected=selected.skills}}</multi-select>
      </div>
    </div>

    <div class="form-group">
      <label for="{{rootId}}-tools">{{localize "KT.Archetypes.Tools"}} {{> kt-info text=(localize "KT.Archetypes.ToolsHint")}}</label>
      <div class="form-fields">
        <input type="text" id="{{rootId}}-tools" name="tools" value="{{selected.tools}}" placeholder="smith, thief">
      </div>
    </div>

    <div class="form-group stacked">
      <label for="{{rootId}}-stocks">{{localize "KT.Archetypes.Stocks"}}</label>
      <textarea id="{{rootId}}-stocks" name="stocks" class="kt-json" spellcheck="false">{{selected.stocks}}</textarea>
    </div>

    <div class="form-group stacked">
      <label for="{{rootId}}-favored">{{localize "KT.Archetypes.Favored"}} {{> kt-info text=(localize "KT.Archetypes.FilterHint")}}</label>
      <textarea id="{{rootId}}-favored" name="favored" class="kt-json" spellcheck="false">{{selected.favored}}</textarea>
    </div>

    <div class="form-group stacked">
      <label for="{{rootId}}-reactions">{{localize "KT.Archetypes.Reactions"}} {{> kt-info text=(localize "KT.Archetypes.ReactionsHint")}}</label>
      <textarea id="{{rootId}}-reactions" name="reactions" class="kt-json" spellcheck="false" placeholder="{{localize "KT.Archetypes.ReactionsPlaceholder"}}">{{selected.reactions}}</textarea>
    </div>

    <div class="form-group stacked">
      <label for="{{rootId}}-services">{{localize "KT.Archetypes.Services"}} {{> kt-info text=(localize "KT.Archetypes.ServicesHint")}}</label>
      <textarea id="{{rootId}}-services" name="services" class="kt-json" spellcheck="false" placeholder="{{localize "KT.Archetypes.ServicesPlaceholder"}}">{{selected.services}}</textarea>
    </div>

    <button type="button" data-action="remove">
      {{#if selected.custom}}
      <i class="fa-solid fa-trash" inert></i> {{localize "KT.Archetypes.Delete"}}
      {{else}}
      <i class="fa-solid fa-rotate-left" inert></i> {{localize "KT.Archetypes.Reset"}}
      {{/if}}
    </button>
  </section>
  {{/if}}
</div>
