<section class="kt-market-selected" aria-live="polite">
  <h3 class="kt-market-heading">{{localize "KT.Market.Selected.Title"}}</h3>
  {{#if selected}}
  <div class="kt-selected-card">
    <img src="{{selected.img}}" alt="">
    <div class="kt-selected-text">
      <strong>{{selected.name}}</strong>
      <span class="kt-muted">{{selected.status}}</span>
    </div>
    <div class="kt-selected-actions">
      {{#if selected.shop}}
      <button type="button" data-action="tradeSelected"><i class="fa-solid fa-scale-balanced" inert></i> {{localize "KT.Market.Trade"}}</button>
      <button type="button" data-action="configureSelected"><i class="fa-solid fa-sliders" inert></i> {{localize "KT.Shop.Configure"}}</button>
      {{else}}
      <button type="button" class="kt-primary" data-action="configureSelected"><i class="fa-solid fa-store" inert></i> {{localize "KT.Shop.SetUp"}}</button>
      {{/if}}
    </div>
  </div>
  {{else}}
  <p class="hint">{{selectedHint}}</p>
  {{/if}}
</section>
