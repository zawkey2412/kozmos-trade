<section class="kt-market">
  {{#if setup}}
  <div class="kt-panel kt-setup-bar" aria-live="polite">
    <img class="kt-thumb" src="{{setup.img}}" alt="">
    <span>{{setup.text}}</span>
    <button type="button" data-action="setUp"><i class="fa-solid fa-store" inert></i> {{localize "KT.Shop.SetUp"}}</button>
  </div>
  {{/if}}

  {{#if partyOn}}
  <section class="kt-party-group">
    <h3 class="kt-heading">{{localize "KT.Market.Group.party"}}</h3>
    {{#if party.length}}
    <ol class="kt-list kt-market-rows plain">
      {{#each party as |row|}}
      <li class="kt-row kt-market-row" data-uuid="{{row.uuid}}">
        <div class="kt-row-main">
          <img class="kt-thumb large" src="{{row.img}}" alt="">
          <span class="kt-market-text">
            <strong class="kt-clip">{{row.name}}</strong>
            <span class="kt-muted">{{row.player}}</span>
          </span>
        </div>
        <div class="kt-market-actions">
          <button type="button" data-action="tradePlayer"><i class="fa-solid fa-handshake" inert></i> {{localize "KT.Market.Trade"}}</button>
        </div>
      </li>
      {{/each}}
    </ol>
    {{else}}
    <p class="kt-empty">{{localize "KT.Market.PartyEmpty"}}</p>
    {{/if}}
  </section>
  {{/if}}

  {{#if any}}
  <input type="search" class="kt-market-search" placeholder="{{localize "KT.Market.Search"}}" aria-label="{{localize "KT.Market.Search"}}" value="{{search}}">
  {{/if}}

  {{#if rules}}
  <div class="kt-note kt-rules-line">
    <i class="fa-solid fa-chart-line" inert></i>
    <span>{{rules.text}}</span>
    <button type="button" data-action="rules">{{localize "KT.Market.RulesLine.Edit"}}</button>
  </div>
  {{/if}}

  <div class="kt-market-scroll">
    {{#if any}}
    {{#each groups as |group|}}
    <section class="kt-market-group">
      <h3 class="kt-heading">{{group.label}}</h3>
      <ol class="kt-list kt-market-rows plain">
        {{#each group.rows as |row|}}
        <li class="kt-row kt-market-row{{#unless row.open}} disabled{{/unless}}{{#if row.selected}} active{{/if}}" data-uuid="{{row.uuid}}" data-name="{{row.name}}">
          {{#if @root.gm}}
          <button type="button" class="kt-row-main" data-action="configure" data-tooltip-text="{{localize "KT.Market.RowHint"}}">
          {{else}}
          <div class="kt-row-main">
          {{/if}}
            <img class="kt-thumb large" src="{{row.img}}" alt="">
            <span class="kt-market-text">
              <strong class="kt-clip">{{row.name}}</strong>
              <span class="kt-muted">{{row.archetype}}{{#if group.elsewhere}}, {{row.scene}}{{/if}}</span>
              <span class="kt-muted kt-toolbar kt-market-facts">
                {{#unless @root.gm}}
                <span><i class="fa-solid {{#if row.open}}fa-door-open{{else}}fa-door-closed{{/if}}" inert></i> {{row.status}}</span>
                {{/unless}}
                <span><i class="fa-regular fa-calendar" inert></i> {{row.visited}}</span>
                {{#if @root.gm}}{{#if row.remote}}<span><i class="fa-solid fa-store" inert></i> {{localize "KT.Market.Remote"}}</span>{{/if}}{{/if}}
              </span>
              {{#if row.note}}<span class="kt-muted kt-market-note">{{row.note}}</span>{{/if}}
            </span>
          {{#if @root.gm}}</button>{{else}}</div>{{/if}}
          <div class="kt-market-actions">
            {{#if @root.gm}}
            <button type="button" class="kt-open-toggle{{#if row.open}} active{{/if}}" data-action="toggleOpen" aria-pressed="{{row.open}}"
                    data-tooltip-text="{{row.openHint}}">
              <i class="fa-solid {{#if row.open}}fa-door-open{{else}}fa-door-closed{{/if}}" inert></i> {{row.status}}
            </button>
            {{#if row.place}}
            <button type="button" class="inline-control icon fa-solid fa-location-crosshairs" data-action="find"
                    data-scene="{{row.place.scene}}" data-token="{{row.place.token}}"
                    data-tooltip aria-label="{{localize "KT.Market.Find"}}"></button>
            {{/if}}
            <button type="button" class="inline-control icon fa-solid fa-scale-balanced" data-action="trade"
                    data-tooltip aria-label="{{localize "KT.Shop.Trade"}}"></button>
            {{else if row.canTrade}}
            <button type="button" data-action="trade"><i class="fa-solid fa-scale-balanced" inert></i> {{localize "KT.Market.Trade"}}</button>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ol>
    </section>
    {{/each}}
    <p class="kt-empty kt-market-nomatch hidden">{{localize "KT.Market.NoMatch"}}</p>
    {{else}}
    <p class="kt-empty">{{empty}}</p>
    {{/if}}
  </div>
</section>
