<section class="kt-rules">
  {{#if off}}
  <p class="kt-warning"><i class="fa-solid fa-triangle-exclamation" inert></i> {{localize "KT.Market.Rules.Off"}}</p>
  {{/if}}
  <p class="hint">{{localize "KT.Market.Rules.Intro"}}</p>

  {{#if rows.length}}
  <ol class="kt-list kt-rule-list plain">
    {{#each rows as |row|}}
    <li class="kt-row kt-rule-row{{#if row.ended}} disabled{{/if}}">
      <div class="kt-rule-text">
        <strong>{{row.name}} {{row.change}}</strong>
        <span class="kt-muted">{{row.categories}}</span>
        <span class="kt-muted"><i class="fa-solid fa-location-dot" inert></i> {{row.where}} <i class="fa-regular fa-clock" inert></i> {{row.ends}}</span>
      </div>
      <button type="button" class="inline-control icon fa-solid fa-trash" data-action="remove" data-rule="{{row.id}}"
              data-tooltip aria-label="{{localize "KT.Market.Rules.Remove"}}"></button>
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="kt-empty">{{localize "KT.Market.Rules.Empty"}}</p>
  {{/if}}

  <fieldset>
    <legend>{{localize "KT.Market.Rules.New"}}</legend>
    <div class="form-group">
      <label for="{{rootId}}-name">{{localize "KT.Market.Rules.Name"}}</label>
      <div class="form-fields">
        <input type="text" id="{{rootId}}-name" name="name" placeholder="{{localize "KT.Market.Rules.NamePlaceholder"}}">
      </div>
    </div>
    <div class="form-group">
      <label for="{{rootId}}-scope">{{localize "KT.Market.Rules.Where"}}</label>
      <div class="form-fields">
        <select id="{{rootId}}-scope" name="scope">{{selectOptions scopes localize=true}}</select>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "KT.Market.Rules.Categories"}}</label>
      <div class="form-fields">
        <multi-select name="categories">{{selectOptions categories localize=true}}</multi-select>
      </div>
      <p class="hint">{{localize "KT.Market.Rules.CategoriesHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{rootId}}-percent">{{localize "KT.Market.Rules.Percent"}}</label>
      <div class="form-fields">
        <input type="number" id="{{rootId}}-percent" name="percent" step="1" placeholder="30">
        <span class="units">%</span>
      </div>
      <p class="hint">{{localize "KT.Market.Rules.PercentHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{rootId}}-days">{{localize "KT.Market.Rules.Days"}}</label>
      <div class="form-fields">
        <input type="number" id="{{rootId}}-days" name="days" min="0" step="1" placeholder="7">
      </div>
      <p class="hint">{{localize "KT.Market.Rules.DaysHint"}}</p>
    </div>
  </fieldset>
</section>
