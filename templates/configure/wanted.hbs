<section class="tab kt-configure-wanted{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <p class="hint">{{localize "KT.Wanted.ConfigureHint"}}</p>
  {{#if wanted.length}}
  <ul class="kt-wanted-rows plain">
    {{#each wanted as |entry|}}
    <li>{{#if entry.img}}<img src="{{entry.img}}" alt="">{{/if}}<span>{{entry.label}}</span> <strong>{{localize "KT.Wanted.Pays" rate=entry.rate}}</strong></li>
    {{/each}}
  </ul>
  {{else}}
  <p class="kt-empty">{{localize "KT.Wanted.Empty"}}</p>
  {{/if}}
  <div class="kt-wanted-tools">
    <button type="button" data-action="rollWanted"><i class="fa-solid fa-dice" inert></i> {{localize "KT.Wanted.Roll"}}</button>
  </div>
</section>
