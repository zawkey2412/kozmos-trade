<section class="tab kt-configure-setup{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <p class="hint">{{localize "KT.Configure.MenuHint"}}</p>

  <fieldset>
    <legend>{{localize "KT.Configure.Status"}}</legend>
    <div class="form-group kt-toggle">
      <label for="{{rootId}}-open">{{localize "KT.Configure.Open.Label"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{rootId}}-open" name="open" {{checked shop.open}}>
      </div>
      <p class="hint">{{localize "KT.Configure.Open.Hint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{rootId}}-mode">{{localize "KT.Configure.ExecutionMode.Label"}}</label>
      <div class="form-fields">
        <select id="{{rootId}}-mode" name="executionMode">
          {{selectOptions modes selected=shop.executionMode localize=true}}
        </select>
      </div>
      <p class="hint">{{localize "KT.Configure.ExecutionMode.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KT.Configure.Kind"}}</legend>
    <div class="form-group">
      <label for="{{rootId}}-archetype">{{localize "KT.Configure.Archetype"}}</label>
      <div class="form-fields">
        <select id="{{rootId}}-archetype" name="archetype">
          {{selectOptions archetypes selected=shop.archetype}}
        </select>
      </div>
      <p class="hint">{{localize "KT.Configure.ArchetypeHint"}}</p>
    </div>
    <div class="form-group">
      <label for="{{rootId}}-tier">{{localize "KT.Configure.Tier"}}</label>
      <div class="form-fields">
        <select id="{{rootId}}-tier" name="tier">
          {{selectOptions tiers selected=shop.tier localize=true}}
        </select>
      </div>
      <p class="hint">{{localize "KT.Configure.TierHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "KT.Configure.Rules"}}</legend>
    <div class="form-group kt-toggle">
      <label for="{{rootId}}-remote">{{localize "KT.Configure.Remote.Label"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{rootId}}-remote" name="remoteTrade" {{checked shop.remoteTrade}}>
      </div>
      <p class="hint">{{localize "KT.Configure.Remote.Hint"}}</p>
    </div>
    {{#if theftOn}}
    <div class="form-group kt-toggle">
      <label for="{{rootId}}-theft-proof">{{localize "KT.Configure.TheftProof.Label"}}</label>
      <div class="form-fields">
        <input type="checkbox" id="{{rootId}}-theft-proof" name="theftProof" {{checked shop.theftProof}}>
      </div>
      <p class="hint">{{localize "KT.Configure.TheftProof.Hint"}}</p>
    </div>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "KT.Identity.Legend"}}</legend>
    <div class="form-group kt-identity">
      <div class="form-fields">
        <span class="kt-identity-value"><i class="fa-solid {{identity.icon}}" inert></i> {{identity.label}}</span>
        <button type="button" data-action="changeIdentity"><i class="fa-solid fa-pen" inert></i> {{localize "KT.Identity.Change"}}</button>
      </div>
      <p class="hint">{{identity.hint}}</p>
    </div>
  </fieldset>
</section>
