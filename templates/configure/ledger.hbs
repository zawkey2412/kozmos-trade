<fieldset class="kt-configure-ledger">
  <legend>{{localize "KT.Ledger.Label"}}</legend>
  {{#if ledger.length}}
  <ol class="kt-ledger-list plain">
    {{#each ledger as |entry|}}
    <li class="kt-ledger-row{{#if entry.reverted}} reverted{{/if}}">
      <span class="kt-ledger-who">{{entry.customer}}</span>
      <span class="kt-ledger-what">{{entry.summary}}</span>
      {{#if entry.reverted}}
      <span class="kt-muted">{{localize "KT.Receipt.RevertedNote"}}</span>
      {{else}}
      <button type="button" class="inline-control icon fa-solid fa-rotate-left" data-action="revert" data-entry="{{entry.id}}"
              data-tooltip aria-label="{{localize "KT.Receipt.Revert"}}"></button>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="kt-empty">{{localize "KT.Ledger.Empty"}}</p>
  {{/if}}
</fieldset>
