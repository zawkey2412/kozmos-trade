<section class="tab kt-configure-ledger{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <p class="hint">{{localize "KT.Ledger.Hint"}}</p>
  {{#if ledger.length}}
  <ol class="kt-ledger-list plain">
    {{#each ledger as |entry|}}
    <li class="kt-ledger-row{{#if entry.reverted}} reverted{{/if}}">
      <span class="kt-ledger-who">{{entry.customer}}</span>
      <span class="kt-ledger-what">{{entry.summary}}</span>
      {{#if entry.reverted}}
      <span class="kt-muted">{{localize "KT.Receipt.RevertedNote"}}</span>
      {{else}}
      <button type="button" class="kt-ledger-revert" data-action="revert" data-entry="{{entry.id}}">
        <i class="fa-solid fa-rotate-left" inert></i> {{localize "KT.Receipt.Revert"}}
      </button>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="kt-empty">{{localize "KT.Ledger.Empty"}}</p>
  {{/if}}
</section>
