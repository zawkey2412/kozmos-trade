<section class="tab kt-configure-stock{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="kt-section-head">
    <p class="kt-note"><i class="fa-solid fa-file-import" inert></i> <span>{{localize "KT.Configure.Stock.Drop"}} {{> kt-info text=(localize "KT.Configure.Stock.Hint")}}</span></p>
    <button type="button" class="kt-act" data-action="generate"><i class="fa-solid fa-dice" inert></i> {{localize "KT.Configure.Generate"}}</button>
  </div>

  {{#if rows.length}}
  <div class="kt-stock-head">
    <span class="kt-stock-name">{{localize "KT.Configure.Stock.Item"}}</span>
    <span class="kt-stock-value">{{localize "KT.Configure.Stock.Value"}}</span>
    <span>{{localize "KT.Configure.Stock.Price"}}</span>
    <span class="kt-stock-pin" data-tooltip aria-label="{{localize "KT.Configure.Stock.Pin"}}"><i class="fa-solid fa-thumbtack" inert></i></span>
  </div>
  <ol class="kt-list kt-stock-list plain">
    {{#each rows as |row|}}
    <li class="kt-row kt-stock-row{{#unless row.forSale}} disabled{{/unless}}">
      <span class="kt-stock-name">
        <img class="kt-thumb" src="{{row.img}}" alt="">
        <span class="kt-clip">{{row.name}}</span>
        {{#if (gt row.quantity 1)}}<span class="kt-quantity">{{row.quantity}}</span>{{/if}}
        {{#if row.underCounter}}<i class="fa-solid fa-box-open kt-under-counter" data-tooltip aria-label="{{localize "KT.Tag.underCounter"}}"></i>{{/if}}
      </span>
      <span class="kt-stock-value">{{row.value}}</span>
      <span class="kt-stock-price">
        <input type="number" name="items.{{row.id}}.price" value="{{row.price}}" placeholder="{{row.placeholder}}"
               min="0" step="0.01" aria-label="{{localize "KT.Configure.Stock.Price"}}" {{disabled (not row.forSale)}}>
        <span class="kt-unit">{{localize "DND5E.CurrencyAbbrGP"}}</span>
      </span>
      <span class="kt-stock-pin">
        <input type="checkbox" name="items.{{row.id}}.pinned" {{checked row.pinned}}
               data-tooltip aria-label="{{localize "KT.Configure.Stock.Pin"}}">
      </span>
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="kt-empty">{{localize "KT.Configure.Stock.Empty"}}</p>
  {{/if}}

  {{#if wantedOn}}
  <section class="kt-configure-wanted">
    <div class="kt-section-head">
      <h3 class="kt-heading">{{localize "KT.Wanted.Title"}} {{> kt-info text=(localize "KT.Wanted.ConfigureHint")}}</h3>
      <button type="button" class="kt-act" data-action="rollWanted"><i class="fa-solid fa-dice" inert></i> {{localize "KT.Wanted.Roll"}}</button>
    </div>
    {{#if wanted.length}}
    <ul class="kt-list kt-wanted-rows plain">
      {{#each wanted as |entry|}}
      <li class="kt-row">{{#if entry.img}}<img class="kt-thumb" src="{{entry.img}}" alt="">{{else}}<i class="fa-solid fa-bullhorn kt-thumb" inert></i>{{/if}}<span class="kt-clip">{{entry.label}}</span> <strong>{{localize "KT.Wanted.Pays" rate=entry.rate}}</strong></li>
      {{/each}}
    </ul>
    {{else}}
    <p class="kt-empty">{{localize "KT.Wanted.Empty"}}</p>
    {{/if}}
  </section>
  {{/if}}
</section>
