<section class="kt-feature-list">
  <p class="hint">{{intro}}</p>
  {{#each features as |feature|}}
  <div class="form-group">
    <label for="{{@root.rootId}}-{{feature.name}}">{{localize feature.label}}</label>
    <div class="form-fields">
      <span class="kt-preset{{#if feature.changed}} kt-changed{{/if}}">{{feature.preset}}</span>
      <input type="checkbox" id="{{@root.rootId}}-{{feature.name}}" name="{{feature.name}}" {{checked feature.checked}}>
    </div>
    <p class="hint">{{localize feature.hint}}</p>
  </div>
  {{/each}}
</section>
