<li class="kt-card{{#if dim}} dim{{/if}}{{#if disabled}} disabled{{/if}}{{#if staged}} staged{{/if}}" data-item-id="{{id}}" data-side="{{side}}"
    {{#unless disabled}}draggable="true" data-action="stage" tabindex="0" role="button"{{/unless}} aria-label="{{name}}"
    data-tooltip-html="{{tooltip}}" data-tooltip-class="kt-tooltip" data-tooltip-direction="LEFT">
  {{#if icon}}<i class="{{icon}} kt-card-icon" inert></i>{{else}}<img src="{{img}}" alt="">{{/if}}
  <div class="kt-card-text">
    <span class="kt-card-name kt-clip">{{name}}</span>
    {{#if tags.length}}
    <span class="kt-card-tags">
      {{#each tags as |tag|}}<span class="kt-tag {{tag.key}}">{{#if tag.icon}}<i class="{{tag.icon}}" inert></i>{{/if}}{{tag.label}}</span>{{/each}}
    </span>
    {{/if}}
  </div>
  <div class="kt-card-side">
    {{#if canEmpty}}
    <button type="button" class="kt-card-action icon" data-action="empty" data-tooltip-text="{{localize "KT.Barter.Empty"}}" aria-label="{{localize "KT.Barter.Empty"}}">
      <i class="fa-solid fa-box-open" inert></i>
    </button>
    {{else}}
    {{#if canAppraise}}
    <button type="button" class="kt-card-action icon" data-action="appraise" data-tooltip-text="{{localize "KT.Appraise.Button"}}" aria-label="{{localize "KT.Appraise.Button"}}">
      <i class="fa-solid fa-magnifying-glass-dollar" inert></i>
    </button>
    {{/if}}
    {{#if canPocket}}
    <button type="button" class="kt-card-action kt-pocket-button icon" data-action="pocket" data-tooltip-text="{{localize "KT.Theft.Button"}}" aria-label="{{localize "KT.Theft.Button"}}">
      <i class="fa-solid fa-hand" inert></i>
    </button>
    {{/if}}
    <span class="kt-card-price">{{priceLabel}}</span>
    {{#if (gt quantity 1)}}<span class="kt-card-quantity">{{available}}</span>{{/if}}
    {{/if}}
  </div>
</li>
