<li class="kt-card{{#if dim}} dim{{/if}}{{#if disabled}} disabled{{/if}}{{#if staged}} staged{{/if}}" data-item-id="{{id}}" data-side="{{side}}"
    {{#unless disabled}}draggable="true" data-action="stage" tabindex="0" role="button"{{/unless}} aria-label="{{name}}">
  <img src="{{img}}" alt="">
  <div class="kt-card-text">
    <span class="kt-card-name">{{name}}</span>
    {{#if tags.length}}
    <span class="kt-card-tags">
      {{#each tags as |tag|}}<span class="kt-tag {{tag.key}}">{{#if tag.icon}}<i class="{{tag.icon}}" inert></i>{{/if}}{{tag.label}}</span>{{/each}}
    </span>
    {{/if}}
  </div>
  <div class="kt-card-side">
    {{#if canEmpty}}
    <button type="button" class="kt-empty-button" data-action="empty">
      <i class="fa-solid fa-box-open" inert></i> <span>{{localize "KT.Barter.Empty"}}</span>
    </button>
    {{else}}
    <span class="kt-card-price">{{priceLabel}}</span>
    {{#if (gt quantity 1)}}<span class="kt-card-quantity">{{available}}</span>{{/if}}
    {{/if}}
  </div>
</li>
