<section class="kt-inventory" data-side="{{side}}">
  {{#if tabs}}
  <nav class="kt-tabs" role="tablist">
    {{#each tabs as |tab|}}
    <button type="button" class="kt-tab{{#if tab.active}} active{{/if}}" data-action="merchantTab" data-tab="{{tab.id}}" role="tab" aria-selected="{{tab.active}}">{{tab.label}}</button>
    {{/each}}
  </nav>
  {{/if}}
  {{#if wanted.length}}
  <div class="kt-wanted" data-tooltip-text="{{localize "KT.Wanted.Hint"}}">
    <span class="kt-wanted-title"><i class="fa-solid fa-bullhorn" inert></i> {{localize "KT.Wanted.Title"}}</span>
    {{#each wanted as |entry|}}
    <span class="kt-wanted-entry">{{#if entry.img}}<img src="{{entry.img}}" alt="">{{/if}}{{entry.label}} <strong>{{entry.rate}}</strong></span>
    {{/each}}
  </div>
  {{/if}}
  <div class="kt-inventory-tools">
    <input type="search" class="kt-search" data-side="{{side}}" value="{{search}}"
           placeholder="{{localize "KT.Barter.Search"}}" aria-label="{{localize "KT.Barter.Search"}}">
    <select class="kt-sort" data-side="{{side}}" aria-label="{{localize "KT.Barter.Sort"}}">
      {{selectOptions sorts selected=sort localize=true}}
    </select>
  </div>
  <div class="kt-chips" role="toolbar">
    {{#each chips as |chip|}}
    <button type="button" class="kt-chip{{#if chip.active}} active{{/if}}" data-action="category" data-side="{{../side}}"
            data-category="{{chip.id}}" aria-pressed="{{chip.active}}">{{chip.label}}</button>
    {{/each}}
  </div>
  {{#if items.length}}
  <ol class="kt-inventory-list plain">
    {{#each items as |item|}}{{> kt-card item}}{{/each}}
  </ol>
  {{else}}
  <p class="kt-empty">{{empty}}</p>
  {{/if}}
</section>
