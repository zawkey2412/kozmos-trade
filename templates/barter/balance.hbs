<section class="kt-balance {{balance.state}}" aria-live="polite">
  <div class="kt-balance-head">
    <i class="fa-solid {{balance.icon}} kt-scale" inert></i>
    <strong class="kt-net">{{balance.readout}}</strong>
    <span class="kt-word">{{balance.word}}</span>
  </div>
  {{#if balance.change}}
  <p class="kt-note"><i class="fa-solid fa-coins" inert></i> {{localize "KT.Balance.Change" amount=balance.change}}</p>
  {{/if}}
  <div class="kt-pairs">
    <div><span>{{localize "KT.Barter.YouOffer"}}</span><span>{{balance.customer}}</span></div>
    <div><span>{{localize "KT.Barter.YouGet"}}</span><span>{{balance.merchant}}</span></div>
  </div>
  {{#if balance.modifiers.length}}
  <ul class="kt-pairs kt-modifiers plain">
    {{#each balance.modifiers as |modifier|}}
    <li class="{{modifier.tone}}"><span>{{modifier.label}}</span><strong>{{modifier.value}}</strong></li>
    {{/each}}
  </ul>
  {{/if}}
  {{#if balance.haggle}}
  {{#if balance.haggle.locked}}
  <p class="kt-note"><i class="fa-solid fa-lock" inert></i> {{balance.haggle.text}}</p>
  {{else}}
  <button type="button" class="kt-haggle" data-action="haggle" {{disabled balance.haggle.disabled}}{{#if balance.haggle.reason}} data-tooltip-text="{{balance.haggle.reason}}"{{/if}}>
    <i class="fa-solid fa-comments-dollar" inert></i> {{localize "KT.Haggle.Button"}}
  </button>
  {{/if}}
  {{/if}}
  {{#if balance.distracted}}
  <p class="kt-note"><i class="fa-solid fa-masks-theater" inert></i> {{balance.distracted}}</p>
  {{/if}}
  {{#if balance.cannotCover}}
  <p class="kt-warning"><i class="fa-solid fa-triangle-exclamation" inert></i> {{localize "KT.Balance.CannotCover"}}</p>
  {{/if}}
</section>
