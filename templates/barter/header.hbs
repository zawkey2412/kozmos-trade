<header class="kt-barter-header">
  <div class="kt-party kt-party-customer">
    <img class="kt-portrait" src="{{header.customer.img}}" alt="">
    <div class="kt-party-text">
      <h2>{{header.customer.name}}</h2>
      <span class="kt-muted"><i class="fa-solid fa-coins" inert></i> {{header.customer.coins}}</span>
      {{#if header.remote}}<span class="kt-muted"><i class="fa-solid fa-store" inert></i> {{localize "KT.Barter.Remote"}}</span>{{/if}}
    </div>
  </div>

  <div class="kt-header-middle">
    {{#if header.counter}}
    <span class="kt-counter-label"><i class="fa-solid fa-pen" inert></i> {{localize "KT.Barter.CounterTitle"}}</span>
    {{else if gm}}
    <div class="kt-gm-tools" role="toolbar" aria-label="{{localize "KT.Barter.GMTools"}}">
      <span class="kt-gm-label">{{localize "KT.Barter.GMTools"}}</span>
      <button type="button" class="kt-mode-toggle" data-action="toggleMode" data-tooltip-text="{{localize "KT.Barter.ToggleMode"}}">
        <i class="{{header.modeIcon}}" inert></i> <span>{{header.mode}}</span>
      </button>
      <button type="button" data-action="showPlayers" data-tooltip-text="{{localize "KT.Show.Hint"}}">
        <i class="fa-solid fa-eye" inert></i> <span>{{localize "KT.Barter.Show"}}</span>
      </button>
      <button type="button" data-action="restock" data-tooltip-text="{{localize "KT.Stock.RestockConfirm"}}">
        <i class="fa-solid fa-dice" inert></i> <span>{{localize "KT.Stock.Restock"}}</span>
      </button>
      <button type="button" data-action="revertLast" data-tooltip-text="{{localize "KT.Receipt.RevertBody"}}">
        <i class="fa-solid fa-rotate-left" inert></i> <span>{{localize "KT.Barter.Undo"}}</span>
      </button>
      <button type="button" data-action="configure" data-tooltip-text="{{localize "KT.Shop.Configure"}}">
        <i class="fa-solid fa-sliders" inert></i> <span>{{localize "KT.Barter.Settings"}}</span>
      </button>
    </div>
    {{/if}}
  </div>

  <div class="kt-party kt-party-merchant">
    <div class="kt-party-text">
      <h2>{{header.merchant.name}}</h2>
      <span class="kt-muted">
        {{header.merchant.archetype}}
        {{#if header.attitude}}
        <span class="kt-attitude {{header.attitude.band}}" data-tooltip aria-label="{{header.attitude.label}}">
          <i class="{{header.attitude.icon}}" inert></i> {{header.attitude.label}}
        </span>
        {{/if}}
      </span>
      {{#if (ne header.merchant.purse null)}}
      <meter class="kt-purse" min="0" max="1" low="0.25" optimum="1" value="{{header.merchant.purse}}"
             data-tooltip aria-label="{{#if header.merchant.exactPurse}}{{header.merchant.exactPurse}}{{else}}{{localize "KT.Barter.Purse"}}{{/if}}"></meter>
      {{/if}}
    </div>
    <img class="kt-portrait" src="{{header.merchant.img}}" alt="">
  </div>
</header>
