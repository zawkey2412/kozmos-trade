<header class="kt-barter-header">
  <div class="kt-party kt-party-customer">
    <img class="kt-portrait" src="{{header.customer.img}}" alt="">
    <div class="kt-party-text">
      <h2 class="kt-clip">{{header.customer.name}}</h2>
      <span class="kt-muted"><i class="fa-solid fa-coins" inert></i> {{header.customer.coins}}</span>
      {{#if header.remote}}<span class="kt-muted"><i class="fa-solid fa-store" inert></i> {{localize "KT.Barter.Remote"}}</span>{{/if}}
    </div>
  </div>

  <div class="kt-header-middle">
    {{#if header.counter}}
    <span class="kt-counter-label"><i class="fa-solid fa-pen" inert></i> {{localize "KT.Barter.CounterTitle"}}</span>
    {{else if header.approval}}
    <span class="kt-mode-label"><i class="fa-solid fa-user-check" inert></i> {{localize "KT.ExecutionMode.approval"}}</span>
    {{/if}}
  </div>

  <div class="kt-party kt-party-merchant">
    <div class="kt-party-text">
      <h2 class="kt-clip">{{header.merchant.name}}</h2>
      <span class="kt-muted">
        {{header.merchant.archetype}}
        {{#if header.attitude}}
        <span class="kt-attitude {{header.attitude.band}}" data-tooltip aria-label="{{header.attitude.label}}">
          <i class="{{header.attitude.icon}}" inert></i> {{header.attitude.label}}
        </span>
        {{/if}}
      </span>
      {{#if (ne header.merchant.purse null)}}
      <meter class="kt-purse" min="0" max="1" low="0.25" optimum="1" value="{{header.merchant.purse}}"
             data-tooltip aria-label="{{#if header.merchant.exactPurse}}{{header.merchant.exactPurse}}{{else}}{{localize "KT.Barter.Purse"}}{{/if}}"></meter>
      {{/if}}
    </div>
    <img class="kt-portrait" src="{{header.merchant.img}}" alt="">
  </div>
</header>
