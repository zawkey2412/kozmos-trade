<footer class="kt-barter-footer form-footer">
  <span class="kt-footer-reason kt-muted">{{footer.reason}}</span>
  <button type="button" class="kt-accept bright" data-action="accept" {{disabled footer.disabled}}>
    <i class="{{footer.icon}}" inert></i>
    <span>{{localize footer.label}}</span>
  </button>
</footer>
