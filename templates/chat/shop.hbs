<div class="kozmos-trade kt-chat kt-shop-card">
  <header class="kt-chat-title">
    <i class="fa-solid fa-store" inert></i>
    <strong>{{name}}</strong>
  </header>
  <p class="kt-muted">{{archetype}}</p>
  <p>{{localize "KT.ShopCard.Body" name=name}}</p>
  <div class="kt-chat-buttons">
    <button type="button" data-kt-action="browse"><i class="fa-solid fa-scale-balanced" inert></i> {{localize "KT.ShopCard.Browse"}}</button>
  </div>
</div>
